# --- Server ---
NODE_ENV=development
PORT=5000
# Optional: takes precedence over PORT (handy when a tool injects PORT for the frontend)
API_PORT=5000
# Comma-separated list of allowed frontend origins (the first one is used in email links)
CLIENT_URL=http://localhost:5173

# --- Database (include the database name) ---
MONGO_URI=mongodb://127.0.0.1:27017/agencyflow

# --- Auth (use long random strings in production) ---
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# --- Cloudinary (optional: leave blank to store uploads in /uploads) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email via any SMTP provider (optional: leave blank to log emails instead) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=AgencyFlow <no-reply@agencyflow.dev>

# --- Claude API for AI lead assist (optional) ---
ANTHROPIC_API_KEY=

# --- Misc ---
CRON_ENABLED=true
LOG_LEVEL=info
# COOKIE_SECURE=false   # only for production mode over plain http (e.g. docker compose)
